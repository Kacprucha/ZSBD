--
-- Name: player_inventory_view; Type: VIEW; Schema: game_data; Owner: -
--

CREATE VIEW game_data.player_inventory_view AS
 SELECT p.username AS owner_username,
    ic.character_name,
    i.name AS item_name,
    count(i.iteamid) AS quantity,
    it.category AS item_category,
    r.rarityname AS item_rarity,
    i.description,
    i.atackbonus,
    i.defencebonus,
    i.magicbonus,
    i.price AS purchase_price,
    i.retailprice AS sell_price,
        CASE
            WHEN (q.name IS NOT NULL) THEN ('Nagroda z zadania: '::text || (q.name)::text)
            ELSE 'Loot / Sklep'::text
        END AS item_source
   FROM ((((((game_data.iteam_character ic
     JOIN game_data.iteam i ON ((ic.iteam_iteamid = i.iteamid)))
     JOIN game_data.rarity r ON ((i.rarity_rarityid = r.rarityid)))
     JOIN game_data.itemtype it ON ((i.itemtype_categoryid = it.typeid)))
     JOIN game_data."character" c ON (((ic.character_name)::text = (c.name)::text)))
     JOIN game_data.player p ON (((c.player_userame)::text = (p.username)::text)))
     LEFT JOIN game_data.quest q ON ((i.iteamid = q.iteam_iteamid)))
  GROUP BY p.username, ic.character_name, i.name, it.category, r.rarityname, i.description, i.atackbonus, i.defencebonus, i.magicbonus, i.price, i.retailprice, q.name;


